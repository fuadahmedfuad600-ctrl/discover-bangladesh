# Server-side Gemini AI key (required for AI Trip Planner, Travel Assistant, and district research runner)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Maps use Leaflet + OpenStreetMap (free, no key needed)

# Supabase PostgreSQL & Authentication (optional; falls back to atomic local data store when omitted)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Weather uses Open-Meteo by default (free, no key). WEATHER_API_KEY is optional (OpenWeatherMap).
WEATHER_API_KEY=""

# Optional bearer token protecting POST /api/internal/research/run
RESEARCH_ADMIN_TOKEN=""

# Application public URL
APP_URL="http://localhost:3000"
